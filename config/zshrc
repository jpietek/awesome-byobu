# Read personal settings first; install the shared title hooks last.
terminal_setup_user_zdotdir=${TERMINAL_SETUP_USER_ZDOTDIR:-$HOME}
ZDOTDIR=$terminal_setup_user_zdotdir
if [[ -r "$terminal_setup_user_zdotdir/.zshrc" ]]; then
    source "$terminal_setup_user_zdotdir/.zshrc"
fi
source "${TERMINAL_SETUP_CONFIG}/tab-labels.zsh"
# Linux-style word movement from the terminal profile, including fresh macOS.
bindkey '^[[1;5D' backward-word
bindkey '^[[1;5C' forward-word
