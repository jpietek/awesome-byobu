#!/bin/sh
set -eu
. @SESSION_ENV@
command -v tmux >/dev/null 2>&1 || { echo 'Run setup.sh to install tmux first.' >&2; exit 1; }
if [ "$#" -eq 0 ]; then
    if tmux has-session 2>/dev/null; then
        exec tmux -u attach-session
    fi
    "$terminal_setup_home/.local/bin/byobu-session-restore"
    exec tmux -u attach-session
fi
exec tmux -u -f "$BYOBU_CONFIG_DIR/terminal-setup.tmux" "$@"
