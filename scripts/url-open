#!/bin/sh
set -eu
url=${1:-}
if [ -z "$url" ]; then
    case "$(uname -s)" in
        Darwin) url=$(pbpaste) ;;
        Linux)
            if [ -n "${WAYLAND_DISPLAY:-}" ] && command -v wl-paste >/dev/null 2>&1; then url=$(wl-paste --no-newline)
            elif command -v xclip >/dev/null 2>&1; then url=$(xclip -selection clipboard -o)
            else echo 'Pass a URL, or install wl-clipboard/xclip.' >&2; exit 1; fi ;;
        *) exit 1 ;;
    esac
fi
case "$url" in http://*|https://*) ;; *) echo 'Only http:// and https:// URLs are supported.' >&2; exit 1 ;; esac
case "$(uname -s)" in Darwin) exec open "$url" ;; Linux) exec xdg-open "$url" ;; *) exit 1 ;; esac
